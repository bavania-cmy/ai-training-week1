   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "608 μs ± 33.9 μs per loop (mean ± std. dev. of 7 runs, 1,000 loops each)\n"
     ]
    }
   ],
   "source": [
    "# compare performance using %timeit\n",
    "\n",
    "%timeit [x**2 for x in range(10000)]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "70dec170",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "100 μs ± 4.03 μs per loop (mean ± std. dev. of 7 runs, 10,000 loops each)\n"
     ]
    }
   ],
   "source": [
    "%%timeit result =[]\n",
    "for x in range(1000):\n",
    "    result.append(x**2)"
   ]
  }
